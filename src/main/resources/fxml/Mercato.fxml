<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.scene.layout.*?>
<?import javafx.scene.control.*?>
<?import javafx.geometry.Insets?>

<!--
    Mercato.fxml
    Layout: sidebar filtri sinistra | area centrale (ricerca + griglia stock)
    Il bottone "Compra" è mostrato/nascosto dal controller in base al ruolo.
    Colori: tema dark (#1a1a2e) + accenti viola e verde/rosso per variazioni.
-->
<HBox xmlns:fx="http://javafx.com/fxml"
      stylesheets="@../style.css"
      prefWidth="1200" prefHeight="720">

    <!-- ══ SIDEBAR SINISTRA — navigazione + filtri ═══════════════════════════ -->
    <VBox prefWidth="230" spacing="6" styleClass="schermata-scura">
        <padding><Insets top="30" right="16" bottom="30" left="16"/></padding>

        <Label text="UNIFINANCE" styleClass="titolo-app"/>
        <Label fx:id="lblRuoloSidebar" text="Mercato" styleClass="sottotitolo-app"/>

        <VBox minHeight="20"/>

        <!-- Info utente -->
        <VBox fx:id="boxInfoUtente" styleClass="card-studente" spacing="4">
            <Label fx:id="lblNomeUtente"  text="—"
                   style="-fx-text-fill:#000000; -fx-font-weight:bold;"/>
            <Label fx:id="lblSaldoSidebar" text=""
                   style="-fx-text-fill:#9b8ec4; -fx-font-size:11px;"/>
        </VBox>

        <VBox minHeight="16"/>

        <!-- Navigazione -->
        <Label text="NAVIGA" style="-fx-text-fill:#9b8ec4; -fx-font-size:9px; -fx-font-weight:bold;"/>
        <VBox minHeight="4"/>
        <Button text="⬅  Torna alla Dashboard"
                maxWidth="Infinity"
                onAction="#clickDashboard"
                styleClass="btn-neutro"/>

        <VBox minHeight="20"/>

        <!-- Filtro settore -->
        <Label text="FILTRA PER SETTORE" style="-fx-text-fill:#9b8ec4; -fx-font-size:9px; -fx-font-weight:bold;"/>
        <VBox minHeight="6"/>
        <ComboBox fx:id="cmbSettore"
                  maxWidth="Infinity"
                  promptText="Tutti i settori"
                  styleClass="campo-testo"
                  onAction="#clickFiltroSettore"/>

        <VBox minHeight="12"/>

        <!-- Filtro variazione -->
        <Label text="FILTRA PER TREND" style="-fx-text-fill:#9b8ec4; -fx-font-size:9px; -fx-font-weight:bold;"/>
        <VBox minHeight="6"/>
        <Button fx:id="btnFiltroPositivi" text="📈  Solo positivi"
                maxWidth="Infinity"
                onAction="#clickFiltroPositivi"
                styleClass="btn-neutro"/>
        <Button fx:id="btnFiltroNegativi" text="📉  Solo negativi"
                maxWidth="Infinity"
                onAction="#clickFiltroNegativi"
                styleClass="btn-neutro"/>
        <Button text="↺  Mostra tutti"
                maxWidth="Infinity"
                onAction="#clickResetFiltri"
                styleClass="btn-neutro"/>

        <VBox minHeight="20"/>

        <!-- Stock popolari da cercare rapidamente -->
        <Label text="CERCA RAPIDAMENTE" style="-fx-text-fill:#9b8ec4; -fx-font-size:9px; -fx-font-weight:bold;"/>
        <VBox minHeight="6"/>
        <HBox spacing="6">
            <Button text="AAPL" onAction="#clickQuickSearch" styleClass="btn-neutro"
                    style="-fx-padding:4 10 4 10; -fx-font-size:11px;"/>
            <Button text="TSLA" onAction="#clickQuickSearch" styleClass="btn-neutro"
                    style="-fx-padding:4 10 4 10; -fx-font-size:11px;"/>
            <Button text="MSFT" onAction="#clickQuickSearch" styleClass="btn-neutro"
                    style="-fx-padding:4 10 4 10; -fx-font-size:11px;"/>
        </HBox>
        <HBox spacing="6">
            <Button text="NVDA" onAction="#clickQuickSearch" styleClass="btn-neutro"
                    style="-fx-padding:4 10 4 10; -fx-font-size:11px;"/>
            <Button text="AMZN" onAction="#clickQuickSearch" styleClass="btn-neutro"
                    style="-fx-padding:4 10 4 10; -fx-font-size:11px;"/>
            <Button text="GOOG" onAction="#clickQuickSearch" styleClass="btn-neutro"
                    style="-fx-padding:4 10 4 10; -fx-font-size:11px;"/>
        </HBox>

        <VBox VBox.vgrow="ALWAYS"/>

        <Button text="⬅  Logout"
                maxWidth="Infinity"
                onAction="#clickLogout"
                styleClass="btn-neutro"/>
    </VBox>

    <!-- ══ AREA PRINCIPALE ═══════════════════════════════════════════════════ -->
    <VBox HBox.hgrow="ALWAYS" styleClass="schermata-chiara">

        <!-- ── Barra superiore: titolo + ricerca ─────────────────────────── -->
        <VBox style="-fx-background-color:#ffffff; -fx-effect:dropshadow(gaussian,rgba(0,0,0,0.07),6,0,0,2);">
            <padding><Insets top="20" right="30" bottom="20" left="30"/></padding>
            <HBox alignment="CENTER_LEFT" spacing="16">
                <VBox spacing="2">
                    <Label text="Mercato" styleClass="titolo-schermata"/>
                    <Label fx:id="lblSottotitoloMercato"
                           text="Esplora e analizza gli stock disponibili"
                           styleClass="sottotitolo-schermata"/>
                </VBox>

                <VBox HBox.hgrow="ALWAYS"/>

                <!-- Barra di ricerca -->
                <HBox spacing="8" alignment="CENTER">
                    <TextField fx:id="txtRicerca"
                               promptText="Cerca per simbolo o nome azienda…"
                               prefWidth="300"
                               styleClass="campo-testo"
                               onAction="#clickCerca"/>
                    <Button text="🔍 Cerca"
                            onAction="#clickCerca"
                            styleClass="btn-primario-studente"
                            style="-fx-padding:9 18 9 18;"/>
                    <Button text="↺"
                            onAction="#clickAggiorna"
                            styleClass="btn-neutro"
                            style="-fx-padding:9 14 9 14;"/>
                </HBox>
            </HBox>
        </VBox>

        <!-- ── Area contenuto scrollabile ────────────────────────────────── -->
        <ScrollPane fitToWidth="true" VBox.vgrow="ALWAYS"
                    style="-fx-background-color:#f5f5f5; -fx-background:#f5f5f5;">
            <content>
                <VBox spacing="20">
                    <padding><Insets top="24" right="30" bottom="30" left="30"/></padding>

                    <!-- Messaggi di sistema -->
                    <Label fx:id="lblMessaggio"
                           styleClass="label-errore"
                           visible="false" managed="false"
                           wrapText="true"/>

                    <!-- Indicatore di caricamento -->
                    <HBox fx:id="boxCaricamento" alignment="CENTER" spacing="10"
                          visible="false" managed="false">
                        <ProgressIndicator prefWidth="28" prefHeight="28"
                                           style="-fx-progress-color:#7c4dff;"/>
                        <Label text="Recupero dati da Yahoo Finance…"
                               styleClass="testo-secondario"/>
                    </HBox>

                    <!-- ── PANNELLO DETTAGLIO STOCK (visibile dopo ricerca) ─── -->
                    <VBox fx:id="panelDettaglio" spacing="0"
                          visible="false" managed="false"
                          styleClass="card"
                          style="-fx-border-color:#7c4dff; -fx-border-width:2; -fx-border-radius:14; -fx-background-radius:14;">

                        <!-- Header dettaglio -->
                        <HBox alignment="CENTER_LEFT" spacing="16">
                            <VBox spacing="4" HBox.hgrow="ALWAYS">
                                <HBox spacing="10" alignment="CENTER_LEFT">
                                    <Label fx:id="lblDetSimbolo" text=""
                                           styleClass="simbolo-stock"
                                           style="-fx-font-size:22px;"/>
                                    <Label fx:id="lblDetVariazione" text=""
                                           styleClass="tag-positivo"/>
                                </HBox>
                                <Label fx:id="lblDetNome" text=""
                                       style="-fx-font-size:14px; -fx-text-fill:#555555;"/>
                                <Label fx:id="lblDetSettore" text=""
                                       styleClass="testo-secondario"/>
                            </VBox>

                            <VBox spacing="4" alignment="CENTER_RIGHT">
                                <Label text="Prezzo attuale" styleClass="testo-secondario"/>
                                <Label fx:id="lblDetPrezzo" text=""
                                       styleClass="saldo-grande"
                                       style="-fx-font-size:32px; -fx-text-fill:#1a1a2e;"/>
                                <Label fx:id="lblDetAggiornamento" text=""
                                       styleClass="testo-secondario"
                                       style="-fx-font-size:10px;"/>
                            </VBox>
                        </HBox>

                        <!-- Separatore -->
                        <VBox minHeight="1" style="-fx-background-color:#eeeeee;"/>
                        <VBox minHeight="12"/>

                        <!-- Dati aggiuntivi -->
                        <HBox spacing="30">
                            <VBox spacing="4">
                                <Label text="Var. settimanale" styleClass="testo-secondario"/>
                                <Label fx:id="lblDetVarSettimanale" text="—"
                                       style="-fx-font-weight:bold; -fx-font-size:14px;"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Market Cap" styleClass="testo-secondario"/>
                                <Label fx:id="lblDetMarketCap" text="—"
                                       style="-fx-font-weight:bold; -fx-font-size:14px;"/>
                            </VBox>
                            <VBox spacing="4">
                                <Label text="Volume sett." styleClass="testo-secondario"/>
                                <Label fx:id="lblDetVolume" text="—"
                                       style="-fx-font-weight:bold; -fx-font-size:14px;"/>
                            </VBox>

                            <VBox HBox.hgrow="ALWAYS"/>

                            <!-- Azione: Compra (solo studente) -->
                            <VBox fx:id="boxAzioneAcquisto" spacing="8" alignment="CENTER_RIGHT"
                                  visible="false" managed="false">
                                <Label fx:id="lblSaldoCheck" text="" styleClass="testo-secondario"/>
                                <Button fx:id="btnCompra"
                                        text="💰  Compra ora"
                                        onAction="#clickCompra"
                                        styleClass="btn-positivo"
                                        style="-fx-padding:12 28 12 28; -fx-font-size:14px;"/>
                            </VBox>

                            <!-- Messaggio sola lettura (solo professore) -->
                            <VBox fx:id="boxSolaLettura" spacing="4" alignment="CENTER_RIGHT"
                                  visible="false" managed="false">
                                <Label text="👁  Sola lettura"
                                       style="-fx-text-fill:#1a237e; -fx-font-weight:bold;"/>
                                <Label text="Il professore non può investire."
                                       styleClass="testo-secondario"/>
                            </VBox>
                        </HBox>
                    </VBox>

                    <!-- ── GRIGLIA STOCK MONITORATI ─────────────────────── -->
                    <VBox spacing="12">
                        <HBox alignment="CENTER_LEFT" spacing="8">
                            <Label fx:id="lblTitoloGriglia" text="Stock monitorati"
                                   style="-fx-font-size:16px; -fx-font-weight:bold; -fx-text-fill:#1a1a2e;"/>
                            <Label fx:id="lblContatore" text=""
                                   styleClass="testo-secondario"/>
                        </HBox>

                        <!-- Griglia 3 colonne — popolata dinamicamente -->
                        <FlowPane fx:id="flowStocks"
                                  hgap="16" vgap="16"
                                  prefWrapLength="900"/>

                        <Label fx:id="lblNessunoStock"
                               text="Nessuno stock trovato. Usa la barra di ricerca per aggiungerne uno."
                               styleClass="testo-secondario"
                               visible="false" managed="false"
                               wrapText="true"/>
                    </VBox>

                </VBox>
            </content>
        </ScrollPane>
    </VBox>

</HBox>
